# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# VIKTIG: Hvis databasepassordet ditt har spesialtegn (@ # ? / : & % mellomrom),
# MÅ de prosent-kodes i URLen, ellers får du feilen
# "invalid domain character in database URL". Eksempler:
#   @ → %40   # → %23   ? → %3F   / → %2F   : → %3A   & → %26   % → %25
# Lettest: lag et passord uten spesialtegn i Supabase (Settings → Database →
# Reset database password), så slipper du kodingen helt.
#
# DATABASE_URL = "pooled" tilkobling (Supabase Transaction Pooler, port 6543).
#   Hent i Supabase: Project Settings → Database → Connection string → "Transaction".
#   Husk ?pgbouncer=true (og gjerne &connection_limit=1 på serverless).
DATABASE_URL="postgresql://postgres.<ref>:<passord>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = direkte tilkobling (port 5432) – brukes av `prisma db push`/migrate.
#   Supabase: samme side → "Session"/"Direct connection".
DIRECT_URL="postgresql://postgres.<ref>:<passord>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Admin login ───────────────────────────────────────────────────────────────
# The password Jafar uses to log into /admin. CHANGE THIS before going live.
ADMIN_PASSWORD="bytt-meg"
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET="bytt-meg-til-en-lang-tilfeldig-streng"

# ── Public site ──────────────────────────────────────────────────────────────
# Base URL of the deployed site, used to build absolute iCal export links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Channel sync: Beds24 (optional, near real-time) ──────────────────────────
# Leave empty to disable. When set, the platform pushes availability to Beds24
# and accepts inbound booking webhooks. See README "Kanalsynk".
BEDS24_API_KEY=""
BEDS24_PROP_KEY=""
# Shared secret you set in Beds24 webhook config; we verify inbound calls with it.
BEDS24_WEBHOOK_SECRET=""

# ── Online betaling (Stripe – kort + Vipps) ──────────────────────────────────
# Uten STRIPE_SECRET_KEY er online betaling "av", og bookinger betales via
# bankoverføring (kontonr vises). Opprett konto på stripe.com, aktiver kort
# og Vipps i dashbordet, og lim inn nøklene. Bruk test-nøkler (sk_test_…) først.
STRIPE_SECRET_KEY=""
# Signeringshemmelighet for webhooket (whsec_…). Sett webhook-URL i Stripe til
# https://din-side.no/api/webhooks/stripe og lytt på checkout.session.completed.
STRIPE_WEBHOOK_SECRET=""

# ── E-postvarsling (Resend) ──────────────────────────────────────────────────
# Uten RESEND_API_KEY logges e-poster til konsollen i stedet for å sendes
# (flyten brytes aldri). Opprett gratis konto på resend.com, verifiser domenet
# ditt, og lim inn nøkkelen her.
RESEND_API_KEY=""
# Avsender. Må være på et domene du har verifisert i Resend.
EMAIL_FROM="Jafar Utleie <booking@dittdomene.no>"
# Hvor admin-varsler (nye bookinger/forespørsler) sendes.
ADMIN_EMAIL="jafar@dittdomene.no"

